# =====================
# Unity .gitignore
# =====================

# =====================
# Unity generated folders
# =====================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# =====================
# Unity generated files
# =====================
# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Crash Report
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# =====================
# Visual Studio / Rider / VS Code
# =====================
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# =====================
# OS generated files
# =====================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =====================
# Gradle (Android)
# =====================
/[Aa]ssets/Plugins/Android/gradleOut/
*.gradle
.gradle/
local.properties

# =====================
# Android build artifacts
# =====================
*.apk
*.aab
*.unitypackage
*.keystore
*.jks

# =====================
# IL2CPP build artifacts
# =====================
/[Aa]ssets/Plugins/Android/il2cpp_cache/
Library/il2cpp_*/

# =====================
# Crashlytics
# =====================
crashlytics-build.properties

# =====================
# Plastic SCM
# =====================
*.private
*.private.meta
plastic.ini

# =====================
# Code Coverage
# =====================
/[Cc]ode[Cc]overage/

# =====================
# NuGet
# =====================
*.nupkg
*.nuget.props
*.nuget.targets

# =====================
# Jetbrains
# =====================
.idea/
*.iml

